# Porta do servidor (padrão em plataformas como Render/Railway: fornecida automaticamente pelo $PORT)
PORT=8000

# CORS: Domínios do Frontend permitidos separados por vírgula (ou * para todos)
# Exemplo: https://angecia2026.vercel.app,http://localhost:3000
ALLOWED_ORIGINS="*"

# Credenciais Omnibees
OMNIBEES_ENVIRONMENT="sandbox"
OMNIBEES_ENDPOINT_URL="https://cert.api.omnibees.com/ota2014b/PullService.svc"
OMNIBEES_REQUESTOR_ID=""
OMNIBEES_USERNAME=""
OMNIBEES_API_KEY=""
OMNIBEES_WEBHOOK_SECRET=""

# Credenciais Hotelbeds APItude
HOTELBEDS_API_KEY=""
HOTELBEDS_SECRET=""
HOTELBEDS_ENVIRONMENT="test"
HOTELBEDS_ENDPOINT_URL="https://api.test.hotelbeds.com"

# Senha mestra de administração do Backend
HOSPEDE_ADMIN_PASSCODE=""
VELLUTO_ADMIN_PASSCODE=""

# ============================================================================
# HÓSPEDE CLUB — TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.local (no desenvolvimento) ou configure no
# painel de Environment Variables da sua hospedagem (Vercel / Railway / Render / AWS).
# NENHUMA chave real deve ser salva neste arquivo de exemplo.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CONEXÃO ENTRE SITE (FRONTEND NEXT.JS), BACKEND (FASTAPI) E BANCO DE DADOS
# ----------------------------------------------------------------------------
BACKEND_API_URL=""
BACKEND_INTERNAL_API_TOKEN=""
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ----------------------------------------------------------------------------
# 2. SEGURANÇA DO PORTAL GESTOR (ADMIN & CRM)
# ----------------------------------------------------------------------------
HOSPEDE_ADMIN_PASSCODE=""
HOSPEDE_ADMIN_SESSION_SECRET=""

# ----------------------------------------------------------------------------
# 3. CANAL HOTELEIRO 01: OMNIBEES (PULL & PUSH API OTA 2014B)
# ----------------------------------------------------------------------------
OMNIBEES_ENVIRONMENT="sandbox"
OMNIBEES_ENDPOINT_URL="https://cert.api.omnibees.com/ota2014b/PullService.svc"
OMNIBEES_REQUESTOR_ID=""
OMNIBEES_USERNAME=""
OMNIBEES_API_KEY=""
OMNIBEES_WEBHOOK_SECRET=""
OMNIBEES_RATE_PLAN_NET="RATE_NET_CLUB"
OMNIBEES_RATE_PLAN_BAR="RATE_BAR_PUBLIC"

# ----------------------------------------------------------------------------
# 4. CANAL DE TEMPORADA 02: HÓSPEDE VILLAS (STAYS.NET / AVANTIO / AIRBNB)
# ----------------------------------------------------------------------------
STAYSNET_API_URL=""
STAYSNET_CLIENT_ID=""
STAYSNET_CLIENT_SECRET=""

# ----------------------------------------------------------------------------
# 5. CANAL DE PAGAMENTOS 03: GATEWAY PIX & CARTÃO EM ATÉ 12X (ASAAS / PAGAR.ME / STRIPE)
# ----------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER="ASAAS_PIX"
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ----------------------------------------------------------------------------
# 6. CANAL DE CAMPANHAS DE MEMBROS 04: WHATSAPP API & E-MAIL MARKETING
# ----------------------------------------------------------------------------
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
EMAIL_MARKETING_API_KEY=""
